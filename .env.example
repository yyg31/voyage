# Copy to .env at the repo root; docker-compose reads it automatically.

POSTGRES_USER=asia26
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=asia26

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://asia26.ygouf.com
MAX_UPLOAD_MB=10

# Host ports the containers publish on 127.0.0.1 (Caddy proxies to these).
# Defaults below are usually fine on a fresh host; on a VPS already running
# other Docker projects, change whichever one collides — check first with
# `sudo ss -tlnp | grep -E ':5432|:4000|:3003'` — and update /Caddyfile to match.
HOST_DB_PORT=5432
HOST_BACKEND_PORT=4000
HOST_FRONTEND_PORT=3003
