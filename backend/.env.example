# Copy to .env for local dev (docker-compose injects these via environment: in compose file)

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://asia26:changeme@localhost:5432/asia26?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"

# File uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10

# Seed script - default password for the 9 demo accounts (change after first login)
SEED_DEFAULT_PASSWORD="Asia2026!"
